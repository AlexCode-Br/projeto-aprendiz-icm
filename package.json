{
  "name": "projeto-aprendiz-icm",
  "private": true,
  "version": "1.0.0",
  "description": "Plataforma independente de integração entre alunos e professores do Projeto Aprendiz do Maanaim de Salvador.",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexCode-Br/projeto-aprendiz-icm.git"
  },
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env backend/server.mjs",
    "dev:backend": "node --env-file-if-exists=.env --watch backend/server.mjs",
    "db:migrate": "node backend/migrate.mjs",
    "vapid:generate": "node backend/generate-vapid-keys.mjs",
    "test:mass": "node backend/mass-simulation.mjs",
    "cloudflare:build": "node cloudflare/build.mjs && wrangler deploy --dry-run --outdir cloudflare/build",
    "cloudflare:dev": "wrangler dev",
    "cloudflare:deploy": "pnpm db:migrate && node cloudflare/build.mjs && wrangler deploy",
    "cloudflare:tail": "wrangler tail --format json | node cloudflare/tail-summary.mjs",
    "test": "node --test backend/*.test.mjs",
    "test:postgres": "node --test backend/legacy-drift-migration.test.mjs backend/postgres-migrations.test.mjs",
    "repo:check": "node scripts/check-repository.mjs",
    "check": "pnpm repo:check && pnpm lint && node --check backend/server.mjs && node --check backend/database.mjs && pnpm test && vite build"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.6.1",
    "@supabase/supabase-js": "2.112.4",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.38.0",
    "pg": "8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "react-select": "^5.10.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.6",
    "globals": "15.15.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "vite": "^7.1.3",
    "wrangler": "4.143.1"
  }
}
