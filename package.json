{
  "name": "projeto-aprendiz-aprimorado",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "start": "node backend/server.mjs",
    "dev:backend": "node --watch backend/server.mjs",
    "db:migrate": "node backend/migrate.mjs",
    "cloudflare:build": "node cloudflare/build.mjs && wrangler deploy --dry-run --outdir cloudflare/build",
    "cloudflare:dev": "wrangler dev",
    "cloudflare:deploy": "node cloudflare/build.mjs && wrangler deploy",
    "cloudflare:tail": "wrangler tail --format json | node cloudflare/tail-summary.mjs",
    "check": "node --check backend/server.mjs && node --check backend/database.mjs && node --test backend/*.test.mjs && vite build"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.4",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^1.38.0",
    "pg": "8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "react-select": "^5.10.2"
  },
  "devDependencies": {
    "@eslint/js": "8.57.1",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "globals": "15.15.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "vite": "^7.1.3",
    "wrangler": "4.129.0"
  }
}
