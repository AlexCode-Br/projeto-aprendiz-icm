# Ambiente local
NODE_ENV=development
HOST=127.0.0.1
PORT=4180
APP_URL=http://127.0.0.1:4180
SEED_DEMO_DATA=true

# Produção (PostgreSQL)
# DATABASE_URL=postgresql://usuario:senha@host:5432/projeto_aprendiz
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_SIZE=10

# Primeira conta Gestor em um banco vazio (use uma senha forte e exclusiva)
# BOOTSTRAP_ADMIN_EMAIL=admin@seudominio.com.br
# BOOTSTRAP_ADMIN_PASSWORD=troque-por-uma-senha-segura
# BOOTSTRAP_ADMIN_NAME=Gestor

# Envio de recuperação de senha e convites via Resend
# RESEND_API_KEY=re_...
# EMAIL_FROM=Projeto Aprendiz <acesso@seudominio.com.br>
