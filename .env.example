# Ambiente local
NODE_ENV=development
HOST=127.0.0.1
PORT=4180
APP_URL=http://127.0.0.1:4180
VAPID_SUBJECT=mailto:naoresponda@aprendizicm.com.br
# Gere uma dupla estável com `pnpm vapid:generate`. Nunca versione a chave privada real.
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
APP_TIMEZONE=America/Sao_Paulo
SEED_DEMO_DATA=true
# Produção (PostgreSQL)
# Use a conexão Supavisor em modo Session (porta 5432) do Supabase
# DATABASE_URL=postgresql://postgres.PROJECT_REF:senha@aws-0-regiao.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_SIZE=5

# Autenticação web Supabase
AUTH_PROVIDER=supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_ANNOUNCEMENT_BUCKET=announcement-attachments
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
REQUIRE_MANAGER_MFA=true

# E-mail de uma conta já criada e confirmada em Supabase Auth
# BOOTSTRAP_ADMIN_EMAIL=admin@seudominio.com.br
# BOOTSTRAP_ADMIN_NAME=Gestor

# Envio de recuperação de senha e convites via Resend
# RESEND_API_KEY=re_...
# EMAIL_FROM=Projeto Aprendiz <acesso@seudominio.com.br>
